<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;net48</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <RootNamespace>Zonkey.Tests</RootNamespace>
    <AssemblyName>Zonkey.Tests</AssemblyName>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Versions below are intentionally floating (1.*, 3.*, etc.), not pinned.
       Test runs act as an early-warning system: a new provider/tooling release
       that breaks Zonkey should show up here first, not in a consumer's build. -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="1.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.*" />
    <!-- Lifts transitive SQLitePCLRaw above 2.1.10 (GHSA-2m69-gcr7-jv3q) -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.*" />
    <!-- Npgsql majors mirror what real consumers run per runtime: Npgsql 9 surfaces
         date/time as DateTime/TimeSpan, Npgsql 10 as DateOnly/TimeOnly. Running both
         legs proves Zonkey's conversions are symmetric across the provider change. -->
    <PackageReference Include="Npgsql" Version="10.*" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Npgsql" Version="9.*" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="MySqlConnector" Version="2.*" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zonkey.Data\Zonkey.Data.csproj" />
    <ProjectReference Include="..\..\src\Zonkey.Data.MsSql\Zonkey.Data.MsSql.csproj" />
    <ProjectReference Include="..\..\src\Zonkey.Mocks\Zonkey.Mocks.csproj" />
    <ProjectReference Include="..\..\src\Zonkey.Text\Zonkey.Text.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Seed\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
