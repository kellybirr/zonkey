<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net8.0;net10.0;net48;</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<RootNamespace>Zonkey</RootNamespace>
		<Version>6.6.0</Version>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>Zonkey ORM</Title>
		<Authors>Kelly Birr</Authors>
		<Company />
		<Description>Zonkey ORM Library</Description>
		<PackageProjectUrl>https://github.com/kellybirr/zonkey</PackageProjectUrl>
		<RepositoryUrl>https://github.com/kellybirr/zonkey</RepositoryUrl>
		<PackageReleaseNotes>And Now for Something Completely Different</PackageReleaseNotes>
		<IncludeSymbols>False</IncludeSymbols>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>

<ItemGroup Condition=" '$(TargetFramework)' == 'net48' ">
		<Reference Include="System.Configuration" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.Reflection.Emit.Lightweight" Version="4.7.0" />
	</ItemGroup>

</Project>
