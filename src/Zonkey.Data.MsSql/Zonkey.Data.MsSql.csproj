<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net10.0;net48;</TargetFrameworks>
    <Version>6.6.0</Version>
    <RootNamespace>Zonkey</RootNamespace>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>Zonkey.Data.MsSql.snk</AssemblyOriginatorKeyFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Zonkey MS-SQL Extension</Title>
    <Authors>Kelly Birr</Authors>
    <Description>MS-SQL Extensions for Zoneky.Data 6+</Description>
    <PackageProjectUrl>https://github.com/kellybirr/zonkey</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kellybirr/zonkey</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zonkey.Data\Zonkey.Data.csproj" />
  </ItemGroup>

</Project>
