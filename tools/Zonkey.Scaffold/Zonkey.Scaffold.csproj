<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Zonkey.Scaffold</RootNamespace>
    <AssemblyName>Zonkey.Scaffold</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>zonkey-scaffold</ToolCommandName>
    <PackageId>zonkey.scaffold</PackageId>
    <Description>Scaffolds Zonkey data classes and a DatabaseWrapper from a live database schema.</Description>
    <PackageTags>zonkey;orm;scaffolding;codegen;cli</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="9.*" />
    <PackageReference Include="Humanizer.Core" Version="2.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.*" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.*" />
    <PackageReference Include="Npgsql" Version="9.*" />
    <PackageReference Include="MySqlConnector" Version="2.*" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.*" />
  </ItemGroup>

  <!-- The agent skill ships inside the tool so the `skill` verb can write it into a consuming
       project. One copy, at the repo path agents already load it from. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\.claude\skills\zonkey-scaffold\SKILL.md"
                      LogicalName="Zonkey.Scaffold.SKILL.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zonkey.Scaffold.Tests" />
  </ItemGroup>

</Project>
